      "evidence": [
        {
          "path": "input/manuscript.md",
          "field": "entire file"
        },
        {
          "path": "output/interior.pdf",
          "field": "all pages"
        },
        {
          "path": "output/report.json",
          "field": "/transformations"
        }
      ]
    },
    {
      "claim": "The opening passage before and after formatting, with the finished page's folio",
